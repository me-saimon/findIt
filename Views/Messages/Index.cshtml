@model FindIt.Models.ViewModels.MessagesViewModel
@{
    ViewData["Title"] = "Messages";
    var activePartner = Model.ActivePartner;
    var activeThread = Model.ActiveThread;
    var currentUserId = Model.CurrentUserId;
    var activeItem = Model.ActiveItem;
    int totalUnread = Model.Conversations.Sum(c => c.UnreadCount);

    // Dynamic gradient palette for user avatars
    string GetAvatarColor(string? name)
    {
        string[] gradients = [
            "linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%)",
            "linear-gradient(135deg, #0284C7 0%, #2563EB 100%)",
            "linear-gradient(135deg, #059669 0%, #10B981 100%)",
            "linear-gradient(135deg, #D97706 0%, #F59E0B 100%)",
            "linear-gradient(135deg, #E11D48 0%, #F43F5E 100%)",
            "linear-gradient(135deg, #7C3AED 0%, #C026D3 100%)"
        ];
        int hash = Math.Abs((name ?? "U").GetHashCode());
        return gradients[hash % gradients.Length];
    }

    // Helper to ensure UTC kind then convert to server local time for initial SSR
    DateTime ToLocal(DateTime dt)
    {
        var utc = dt.Kind == DateTimeKind.Utc ? dt : DateTime.SpecifyKind(dt, DateTimeKind.Utc);
        return utc.ToLocalTime();
    }

    string FormatSidebarDate(DateTime? dt)
    {
        if (!dt.HasValue) return "";
        var local = ToLocal(dt.Value);
        var now = DateTime.Now;
        if (local.Date == now.Date) return local.ToString("hh:mm tt");
        if (local.Date == now.Date.AddDays(-1)) return "Yesterday";
        if ((now - local).TotalDays < 7) return local.ToString("ddd");
        return local.ToString("MMM dd");
    }
}

<div class="chat-page-container container">
    <div class="chat-card">
        <!-- ================= Conversations Sidebar ================= -->
        <aside class="chat-sidebar @(activePartner != null ? "mobile-hide" : "")" id="chatSidebar">
            <div class="chat-sidebar-header">
                <div class="chat-sidebar-title-row">
                    <h3 class="chat-sidebar-title">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Messages
                    </h3>
                    @if (totalUnread > 0)
                    {
                        <span class="chat-unread-badge">@totalUnread unread</span>
                    }
                </div>

                <!-- Live Conversation Search -->
                <div class="chat-search-wrap">
                    <svg class="chat-search-icon" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    <input type="text" id="chatSearchInput" class="chat-search-input" placeholder="Search conversations..." autocomplete="off" />
                </div>
            </div>

            <!-- Conversation List -->
            <div class="conversation-list" id="conversationList">
                @if (Model.Conversations.Any())
                {
                    @foreach (var conv in Model.Conversations)
                    {
                        var isSelected = activePartner != null && activePartner.Id == conv.Partner.Id;
                        var avatarBg = GetAvatarColor(conv.Partner.FullName);
                        var userInitial = !string.IsNullOrWhiteSpace(conv.Partner.FullName) 
                            ? conv.Partner.FullName[0].ToString().ToUpper() 
                            : "U";
                        var lastMsgUtcIso = conv.LastMessageTime.HasValue 
                            ? (conv.LastMessageTime.Value.Kind == DateTimeKind.Utc ? conv.LastMessageTime.Value : DateTime.SpecifyKind(conv.LastMessageTime.Value, DateTimeKind.Utc)).ToString("yyyy-MM-ddTHH:mm:ssZ") 
                            : "";

                        <a asp-action="Index" 
                           asp-route-otherUserId="@conv.Partner.Id" 
                           asp-route-itemId="@(conv.RelatedItem?.Id)"
                           class="conversation-item @(isSelected ? "active" : "")"
                           data-user-name="@conv.Partner.FullName.ToLower()"
                           data-user-role="@((conv.Partner.DepartmentOrRole ?? "").ToLower())"
                           data-last-msg="@((conv.LastMessageContent ?? "").ToLower())">
                            
                            <div class="conv-avatar-wrap">
                                <div class="conv-avatar" style="background: @avatarBg;">
                                    @userInitial
                                </div>
                                <span class="avatar-online-dot"></span>
                            </div>

                            <div class="conv-info">
                                <div class="conv-top-row">
                                    <h6 class="conv-name">@conv.Partner.FullName</h6>
                                    @if (conv.LastMessageTime.HasValue)
                                    {
                                        <span class="conv-time" data-utc="@lastMsgUtcIso">
                                            @FormatSidebarDate(conv.LastMessageTime)
                                        </span>
                                    }
                                </div>

                                <div class="conv-bottom-row">
                                    <p class="conv-preview">
                                        @if (!string.IsNullOrEmpty(conv.LastMessageContent))
                                        {
                                            @(conv.IsLastMessageFromMe ? "You: " : "")@conv.LastMessageContent
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Tap to start conversation</span>
                                        }
                                    </p>

                                    @if (conv.UnreadCount > 0)
                                    {
                                        <span class="conv-unread-pill">@conv.UnreadCount</span>
                                    }
                                    else if (!string.IsNullOrEmpty(conv.Partner.DepartmentOrRole))
                                    {
                                        <span class="conv-role-tag">@conv.Partner.DepartmentOrRole</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }

                    <div id="searchNoResults" class="p-4 text-center text-muted small" style="display: none;">
                        No conversations match your search.
                    </div>
                }
                else
                {
                    <div class="chat-empty-state">
                        <div class="chat-empty-icon">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2"/></svg>
                        </div>
                        <h6 class="fw-bold mb-1">No messages yet</h6>
                        <p class="small text-muted mb-3">You can reach out to finders or claimants directly from item listings.</p>
                        <a asp-controller="Items" asp-action="Browse" class="btn-primary-custom py-2 px-3 small">Browse Items</a>
                    </div>
                }
            </div>
        </aside>

        <!-- ================= Active Chat Window ================= -->
        <main class="chat-window @(activePartner == null ? "mobile-hide" : "")" id="chatWindow">
            @if (activePartner != null)
            {
                var partnerAvatarBg = GetAvatarColor(activePartner.FullName);
                var partnerInitial = !string.IsNullOrWhiteSpace(activePartner.FullName) 
                    ? activePartner.FullName[0].ToString().ToUpper() 
                    : "U";

                <!-- Chat Header -->
                <div class="chat-header">
                    <div class="chat-user-info">
                        <button type="button" class="mobile-back-btn" id="mobileBackBtn" title="Back to conversations">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <div class="conv-avatar-wrap">
                            <div class="conv-avatar" style="width: 40px; height: 40px; font-size: 0.95rem; background: @partnerAvatarBg;">
                                @partnerInitial
                            </div>
                            <span class="avatar-online-dot"></span>
                        </div>
                        <div class="chat-user-text">
                            <h5 class="chat-user-name">@activePartner.FullName</h5>
                            <span class="chat-user-status">
                                <span class="status-indicator-dot"></span>
                                @(string.IsNullOrEmpty(activePartner.DepartmentOrRole) ? "Campus Member" : activePartner.DepartmentOrRole)
                            </span>
                        </div>
                    </div>

                    <!-- Linked Item Banner (if conversation is related to an item) -->
                    @if (activeItem != null)
                    {
                        var isLost = activeItem.Type == FindIt.Models.ItemType.Lost;
                        <a asp-controller="Items" asp-action="Details" asp-route-id="@activeItem.Id" class="chat-item-context" target="_blank" title="View related item details">
                            <span class="chat-item-badge @(isLost ? "lost" : "found")">
                                @(isLost ? "Lost" : "Found")
                            </span>
                            <span class="chat-item-title">@activeItem.Title</span>
                            <span class="chat-item-view-btn">
                                View
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </span>
                        </a>
                    }
                </div>

                <!-- Messages Stream Area with Date Dividers -->
                <div class="messages-area" id="messagesArea">
                    @if (activeThread.Any())
                    {
                        DateTime? previousDate = null;

                        @foreach (var msg in activeThread)
                        {
                            var msgLocal = ToLocal(msg.SentAt);
                            var msgUtcIso = (msg.SentAt.Kind == DateTimeKind.Utc ? msg.SentAt : DateTime.SpecifyKind(msg.SentAt, DateTimeKind.Utc)).ToString("yyyy-MM-ddTHH:mm:ssZ");
                            var isSentByMe = msg.SenderId == currentUserId;

                            // Date Separator Heading
                            if (!previousDate.HasValue || previousDate.Value.Date != msgLocal.Date)
                            {
                                previousDate = msgLocal;
                                string dateHeading;
                                var today = DateTime.Today;
                                if (msgLocal.Date == today)
                                {
                                    dateHeading = "Today";
                                }
                                else if (msgLocal.Date == today.AddDays(-1))
                                {
                                    dateHeading = "Yesterday";
                                }
                                else if (msgLocal.Year == today.Year)
                                {
                                    dateHeading = msgLocal.ToString("dddd, MMMM d");
                                }
                                else
                                {
                                    dateHeading = msgLocal.ToString("MMMM d, yyyy");
                                }

                                <div class="chat-date-separator">
                                    <span class="date-badge" data-date-utc="@msgUtcIso">@dateHeading</span>
                                </div>
                            }

                            <!-- Message Bubble -->
                            <div class="msg-bubble @(isSentByMe ? "msg-sent" : "msg-received")">
                                <p class="msg-text">@msg.Content</p>
                                <div class="msg-meta">
                                    <span class="msg-time" data-utc="@msgUtcIso" title="@msgLocal.ToString("dddd, MMMM dd, yyyy 'at' hh:mm tt")">
                                        @msgLocal.ToString("hh:mm tt")
                                    </span>
                                    @if (isSentByMe)
                                    {
                                        <span class="msg-status-icon" title="@(msg.IsRead ? "Read" : "Sent")">
                                            @if (msg.IsRead)
                                            {
                                                <!-- Double Checkmark for Read -->
                                                <svg viewBox="0 0 16 16" fill="currentColor">
                                                    <path d="M12.354 4.354a.5.5 0 0 0-.708-.708L5 10.293 1.854 7.146a.5.5 0 1 0-.708.708l3.5 3.5a.5.5 0 0 0 .708 0l7-7zm-3.5 0a.5.5 0 0 0-.708-.708L5 6.793l.354.353 3.5-3.5z"/>
                                                </svg>
                                            }
                                            else
                                            {
                                                <!-- Single Checkmark for Sent -->
                                                <svg viewBox="0 0 16 16" fill="currentColor">
                                                    <path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/>
                                                </svg>
                                            }
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center my-auto p-4 text-muted">
                            <div class="chat-empty-icon mx-auto mb-3" style="width: 52px; height: 52px;">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2"/></svg>
                            </div>
                            <h6 class="fw-bold mb-1">Start a conversation</h6>
                            <p class="small text-muted mb-0">Send a friendly message to @activePartner.FullName regarding lost & found items.</p>
                        </div>
                    }
                </div>

                <!-- Chat Input Area -->
                <div class="chat-input-area">
                    <form asp-action="Send" method="post" class="input-wrapper" id="chatForm">
                        <input type="hidden" name="receiverId" value="@activePartner.Id" />
                        <input type="hidden" name="itemId" value="@(activeItem?.Id ?? Model.ActiveItemId)" />
                        <input type="text" 
                               name="content" 
                               id="chatInput" 
                               class="chat-input" 
                               placeholder="Type your message..." 
                               required 
                               autocomplete="off" 
                               autofocus />
                        <button type="submit" class="send-btn" id="sendBtn" title="Send message">
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="chat-empty-state">
                    <div class="chat-empty-icon" style="width: 80px; height: 80px;">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">No Conversation Selected</h4>
                    <p class="text-secondary small mb-3" style="max-width: 360px;">
                        Select a person from the sidebar or click "Send Message to Finder/Owner" on any lost & found listing.
                    </p>
                    <a asp-controller="Items" asp-action="Browse" class="btn-primary-custom py-2 px-3">
                        Explore Found Items
                    </a>
                </div>
            }
        </main>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Scroll messages area to the bottom smoothly
            const area = document.getElementById('messagesArea');
            if (area) {
                area.scrollTop = area.scrollHeight;
            }

            // 2. Format client-side accurate timezone dates and times
            function formatClientTimestamps() {
                // Format message bubble times and tooltips
                document.querySelectorAll('.msg-time[data-utc]').forEach(el => {
                    const utcStr = el.getAttribute('data-utc');
                    if (!utcStr) return;
                    const date = new Date(utcStr);
                    if (isNaN(date.getTime())) return;

                    // Formatted time: e.g. "11:05 PM"
                    el.textContent = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                    // Tooltip with full date and time: e.g. "Tuesday, October 13, 2026 at 11:05 PM"
                    const fullDateStr = date.toLocaleDateString([], { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
                    const fullTimeStr = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    el.setAttribute('title', `${fullDateStr} at ${fullTimeStr}`);
                });

                // Format chat date separator badges: e.g. "Today", "Yesterday", "Tuesday, October 13"
                document.querySelectorAll('.date-badge[data-date-utc]').forEach(el => {
                    const utcStr = el.getAttribute('data-date-utc');
                    if (!utcStr) return;
                    const date = new Date(utcStr);
                    if (isNaN(date.getTime())) return;

                    const today = new Date();
                    const yesterday = new Date();
                    yesterday.setDate(today.getDate() - 1);

                    if (date.toDateString() === today.toDateString()) {
                        el.textContent = 'Today';
                    } else if (date.toDateString() === yesterday.toDateString()) {
                        el.textContent = 'Yesterday';
                    } else if (date.getFullYear() === today.getFullYear()) {
                        el.textContent = date.toLocaleDateString([], { weekday: 'long', month: 'short', day: 'numeric' });
                    } else {
                        el.textContent = date.toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' });
                    }
                });

                // Format sidebar conversation timestamps: e.g. "11:05 PM", "Yesterday", "Mon", "Oct 11"
                document.querySelectorAll('.conv-time[data-utc]').forEach(el => {
                    const utcStr = el.getAttribute('data-utc');
                    if (!utcStr) return;
                    const date = new Date(utcStr);
                    if (isNaN(date.getTime())) return;

                    const now = new Date();
                    const yesterday = new Date();
                    yesterday.setDate(now.getDate() - 1);

                    if (date.toDateString() === now.toDateString()) {
                        el.textContent = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    } else if (date.toDateString() === yesterday.toDateString()) {
                        el.textContent = 'Yesterday';
                    } else if ((now - date) / (1000 * 60 * 60 * 24) < 7) {
                        el.textContent = date.toLocaleDateString([], { weekday: 'short' });
                    } else {
                        el.textContent = date.toLocaleDateString([], { month: 'short', day: 'numeric' });
                    }
                });
            }

            formatClientTimestamps();

            // 3. Instant search / filter for sidebar conversations
            const searchInput = document.getElementById('chatSearchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const query = this.value.trim().toLowerCase();
                    const items = document.querySelectorAll('.conversation-item');
                    let visibleCount = 0;

                    items.forEach(item => {
                        const name = item.getAttribute('data-user-name') || '';
                        const role = item.getAttribute('data-user-role') || '';
                        const lastMsg = item.getAttribute('data-last-msg') || '';

                        if (!query || name.includes(query) || role.includes(query) || lastMsg.includes(query)) {
                            item.style.display = 'flex';
                            visibleCount++;
                        } else {
                            item.style.display = 'none';
                        }
                    });

                    const noResults = document.getElementById('searchNoResults');
                    if (noResults) {
                        noResults.style.display = visibleCount === 0 && query ? 'block' : 'none';
                    }
                });
            }

            // 4. Mobile back button navigation
            const mobileBackBtn = document.getElementById('mobileBackBtn');
            if (mobileBackBtn) {
                mobileBackBtn.addEventListener('click', function () {
                    const sidebar = document.getElementById('chatSidebar');
                    const chatWin = document.getElementById('chatWindow');
                    if (sidebar && chatWin) {
                        sidebar.classList.remove('mobile-hide');
                        chatWin.classList.add('mobile-hide');
                    }
                });
            }

            // 5. Focus input on chat window load
            const chatInput = document.getElementById('chatInput');
            if (chatInput) {
                chatInput.focus();
            }
        });
    </script>
}
