@model FindIt.Models.Claim
@{
    ViewData["Title"] = $"Claim #{Model.Id:D5} Details - {Model.Item?.Title}";
    var isClaimant = (bool)(ViewBag.IsClaimant ?? false);
    var isFinder = (bool)(ViewBag.IsFinder ?? false);
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    var currentUserId = (string)(ViewBag.CurrentUserId ?? "");
}

<div class="container py-4">
    <!-- Breadcrumb & Top Controls -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Claims" asp-action="Index">Claims Management</a></li>
                <li class="breadcrumb-item active" aria-current="page">Claim #CLM-@Model.Id.ToString("D5")</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 btn-sm d-inline-flex align-items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Back to Claims
            </a>
            @if (Model.Item != null)
            {
                <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.ItemId" class="btn btn-outline-primary rounded-pill px-3 btn-sm d-inline-flex align-items-center gap-2">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
                    View Item
                </a>
            }
        </div>
    </div>

    <!-- Claim Dossier Header Card -->
    <div class="claim-header-card mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="claim-header-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="claim-reference-pill">#CLM-@Model.Id.ToString("D5")</span>
                        <span class="text-muted small">&bull; Submitted @Model.CreatedAt.ToString("MMM dd, yyyy 'at' hh:mm tt")</span>
                    </div>
                    <h2 class="claim-title mb-0">Ownership Claim Dossier</h2>
                </div>
            </div>

            <!-- Status Badge -->
            <div class="d-flex align-items-center gap-2">
                @switch (Model.Status)
                {
                    case FindIt.Models.ClaimStatus.Pending:
                        <div class="claim-status-badge pending">
                            <span class="pulse-dot"></span>
                            Under Review
                        </div>
                        break;
                    case FindIt.Models.ClaimStatus.Approved:
                        <div class="claim-status-badge approved">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            Claim Approved
                        </div>
                        break;
                    case FindIt.Models.ClaimStatus.Rejected:
                        <div class="claim-status-badge rejected">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            Claim Rejected
                        </div>
                        break;
                    case FindIt.Models.ClaimStatus.Disputed:
                        <div class="claim-status-badge disputed">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><line x1="12" y1="8" x2="12" y2="12" stroke="currentColor" stroke-width="2"/><line x1="12" y1="16" x2="12.01" y2="16" stroke="currentColor" stroke-width="2"/></svg>
                            Disputed
                        </div>
                        break;
                }
            </div>
        </div>

        @if (isFinder)
        {
            <div class="claim-user-role-alert mt-3 finder">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 16v-4M12 8h.01" stroke="currentColor" stroke-width="2"/></svg>
                <span>You reported this item. Please review the claimant's answers and evidence below to verify genuine ownership before making a decision.</span>
            </div>
        }
        else if (isClaimant)
        {
            <div class="claim-user-role-alert mt-3 claimant">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2"/></svg>
                <span>You submitted this ownership claim. The finder is reviewing your evidence. You will be notified when a decision is made.</span>
            </div>
        }
    </div>

    <!-- Main Grid Content -->
    <div class="row g-4">
        <!-- Left Column: Verification Evidence & Decision -->
        <div class="col-lg-8">
            <!-- 1. Secret Question & Answer Card -->
            <div class="claim-content-card mb-4">
                <div class="claim-card-header">
                    <div class="header-icon primary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="2"/></svg>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Ownership Challenge & Secret Answer</h5>
                        <p class="text-muted small mb-0">Finder's question vs. claimant's secret response</p>
                    </div>
                </div>
                <div class="claim-card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.Item?.SecretIdentifier))
                    {
                        <div class="verification-prompt-box mb-3">
                            <div class="d-flex align-items-center gap-2 mb-1 text-primary fw-semibold small text-uppercase letter-spacing">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01" stroke="currentColor" stroke-width="2"/></svg>
                                Finder's Verification Challenge
                            </div>
                            <div class="prompt-text fst-italic">"@Model.Item.SecretIdentifier"</div>
                        </div>
                    }
                    else
                    {
                        <div class="verification-prompt-box mb-3">
                            <div class="d-flex align-items-center gap-2 mb-1 text-secondary fw-semibold small text-uppercase letter-spacing">
                                General Identifying Details
                            </div>
                            <div class="prompt-text text-muted">No specific question was posted; claimant provided unique item identifying features.</div>
                        </div>
                    }

                    <div class="claim-answer-card">
                        <div class="answer-header d-flex align-items-center justify-content-between mb-2">
                            <span class="answer-badge">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/></svg>
                                Claimant's Answer
                            </span>
                            <span class="text-muted small">Submitted with claim</span>
                        </div>
                        <div class="claim-answer-text">
                            "@Model.SecretAnswer"
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Detailed Ownership Description Card -->
            <div class="claim-content-card mb-4">
                <div class="claim-card-header">
                    <div class="header-icon secondary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2"/><polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="2"/><line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="2"/><line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="2"/><polyline points="10 9 9 9 8 9" stroke="currentColor" stroke-width="2"/></svg>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Proof Description & Circumstances</h5>
                        <p class="text-muted small mb-0">Context, contents, purchase details, or serial numbers</p>
                    </div>
                </div>
                <div class="claim-card-body">
                    <div class="proof-description-content">
                        @Model.ProofDescription
                    </div>
                </div>
            </div>

            <!-- 3. Uploaded Attachment Document / Photo -->
            <div class="claim-content-card mb-4">
                <div class="claim-card-header">
                    <div class="header-icon warning">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Supporting Attachment</h5>
                        <p class="text-muted small mb-0">Receipt, past photograph, or documentation</p>
                    </div>
                </div>
                <div class="claim-card-body">
                    @if (!string.IsNullOrEmpty(Model.ProofImageUrl))
                    {
                        <div class="proof-image-stage">
                            <div class="proof-image-wrapper">
                                <img src="@Model.ProofImageUrl" alt="Proof of Ownership Document" class="proof-image" id="proofImagePreview" />
                            </div>
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-3 pt-3 border-top">
                                <div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold px-2 py-1">Document Verified Upload</span>
                                    <span class="text-muted small ms-2">Click below to open full size in high resolution</span>
                                </div>
                                <div class="d-flex gap-2">
                                    <a href="@Model.ProofImageUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center gap-2">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" stroke="currentColor" stroke-width="2"/><polyline points="15 3 21 3 21 9" stroke="currentColor" stroke-width="2"/><line x1="10" y1="14" x2="21" y2="3" stroke="currentColor" stroke-width="2"/></svg>
                                        Open Original
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="empty-attachment-box">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="4" stroke="#CBD5E1" stroke-width="2"/><path d="M21 15l-5-5L5 21" stroke="#CBD5E1" stroke-width="2"/></svg>
                            <h6 class="fw-bold mt-2 mb-1">No Image Attachment Submitted</h6>
                            <p class="text-muted small mb-0">Ownership determination is based upon the secret question verification response and description above.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- 4. Review Decision Console (For Finder or Admin when Pending) -->
            @if ((isFinder || isAdmin) && Model.Status == FindIt.Models.ClaimStatus.Pending)
            {
                <div class="claim-decision-card mb-4" id="reviewConsole">
                    <div class="decision-header">
                        <div class="d-flex align-items-center gap-2">
                            <div class="decision-header-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 11l3 3L22 4" stroke="currentColor" stroke-width="2.5"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" stroke="currentColor" stroke-width="2"/></svg>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">Claim Review Decision Console</h5>
                                <p class="text-muted small mb-0">Approve if the claimant's answer is accurate, or reject if unverified.</p>
                            </div>
                        </div>
                    </div>
                    <div class="decision-body">
                        <p class="text-secondary small mb-3">
                            <strong>Note:</strong> Approving this claim marks the item listing as <strong>Resolved</strong> and informs the claimant to coordinate return. You can add return instructions or handover location in the notes below.
                        </p>

                        <form asp-action="Review" method="post" id="reviewClaimForm">
                            <input type="hidden" name="claimId" value="@Model.Id" />

                            <div class="mb-4">
                                <label for="reviewNotes" class="form-label fw-semibold text-dark">
                                    Review Notes & Coordination Instructions (Optional)
                                </label>
                                <textarea name="reviewNotes" id="reviewNotes" rows="3" class="form-control form-control-custom"
                                          placeholder="e.g., 'Answer verified! Please meet me tomorrow at the Student Center Reception between 2-4 PM to pick it up.' or rejection explanation..."></textarea>
                                <span class="form-text text-muted">These notes will be displayed to the claimant upon decision.</span>
                            </div>

                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 border-top">
                                <a asp-controller="Messages" asp-action="Index" 
                                   asp-route-otherUserId="@Model.ClaimantId" 
                                   asp-route-itemId="@Model.ItemId" 
                                   class="btn btn-outline-secondary rounded-pill px-4">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="me-1"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2"/></svg>
                                    Chat with Claimant First
                                </a>

                                <div class="d-flex gap-2">
                                    <button type="submit" name="status" value="@FindIt.Models.ClaimStatus.Rejected" 
                                            class="btn btn-outline-danger rounded-pill px-4" 
                                            onclick="return confirm('Are you sure you want to reject this claim?');">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="me-1"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2"/></svg>
                                        Reject Claim
                                    </button>
                                    <button type="submit" name="status" value="@FindIt.Models.ClaimStatus.Approved" 
                                            class="btn btn-success rounded-pill px-4 fw-bold shadow-sm"
                                            onclick="return confirm('Approve ownership claim? This will mark the item as resolved.');">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="me-1"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5"/></svg>
                                        Approve & Verify Owner
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <!-- 5. Resolution History (When already reviewed) -->
            @if (Model.Status != FindIt.Models.ClaimStatus.Pending)
            {
                <div class="claim-content-card mb-4 border-@((Model.Status == FindIt.Models.ClaimStatus.Approved) ? "success" : "secondary")">
                    <div class="claim-card-header">
                        <div class="header-icon @((Model.Status == FindIt.Models.ClaimStatus.Approved) ? "success" : "danger")">
                            @if (Model.Status == FindIt.Models.ClaimStatus.Approved)
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5"/></svg>
                            }
                            else
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><line x1="12" y1="8" x2="12" y2="12" stroke="currentColor" stroke-width="2"/><line x1="12" y1="16" x2="12.01" y2="16" stroke="currentColor" stroke-width="2"/></svg>
                            }
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Resolution & Review Outcome</h5>
                            <p class="text-muted small mb-0">Decided on @(Model.ReviewedAt?.ToString("MMMM dd, yyyy 'at' hh:mm tt") ?? Model.CreatedAt.ToString("MMM dd, yyyy"))</p>
                        </div>
                    </div>
                    <div class="claim-card-body">
                        <div class="mb-3">
                            <label class="text-uppercase small fw-bold text-muted d-block mb-1">Status Verdict</label>
                            <span class="fs-5 fw-bold @((Model.Status == FindIt.Models.ClaimStatus.Approved) ? "text-success" : "text-danger")">
                                Claim marked as @Model.Status
                            </span>
                        </div>
                        <div>
                            <label class="text-uppercase small fw-bold text-muted d-block mb-1">Reviewer's Note</label>
                            <div class="p-3 bg-light rounded-3 border">
                                @if (!string.IsNullOrWhiteSpace(Model.ReviewNotes))
                                {
                                    <p class="mb-0 text-dark">@Model.ReviewNotes</p>
                                }
                                else
                                {
                                    <p class="mb-0 text-muted fst-italic">No additional notes were left by the reviewer.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- 6. Dispute Resolution Section -->
            @if (Model.Dispute != null)
            {
                <div class="claim-content-card mb-4 border-warning">
                    <div class="claim-card-header bg-warning-subtle text-warning-emphasis">
                        <div class="header-icon warning">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><line x1="12" y1="8" x2="12" y2="12" stroke="currentColor" stroke-width="2"/><line x1="12" y1="16" x2="12.01" y2="16" stroke="currentColor" stroke-width="2"/></svg>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Dispute Under Investigation</h5>
                            <p class="text-muted small mb-0">Filed on @Model.Dispute.CreatedAt.ToString("MMM dd, yyyy") &bull; Status: @Model.Dispute.Status</p>
                        </div>
                    </div>
                    <div class="claim-card-body">
                        <div class="mb-3">
                            <label class="text-uppercase small fw-bold text-muted d-block mb-1">Dispute Reason</label>
                            <div class="p-3 bg-light rounded-3 border text-dark">
                                @Model.Dispute.Reason
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Dispute.ResolutionNotes))
                        {
                            <div>
                                <label class="text-uppercase small fw-bold text-muted d-block mb-1">Moderator Resolution Notes</label>
                                <div class="p-3 bg-light rounded-3 border text-dark">
                                    @Model.Dispute.ResolutionNotes
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (isClaimant && Model.Status == FindIt.Models.ClaimStatus.Rejected)
            {
                <div class="claim-content-card mb-4">
                    <div class="claim-card-header">
                        <div class="header-icon warning">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 16v-4M12 8h.01" stroke="currentColor" stroke-width="2"/></svg>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Contest Decision / File a Dispute</h5>
                            <p class="text-muted small mb-0">If you believe this claim was rejected in error, submit an appeal for moderator review.</p>
                        </div>
                    </div>
                    <div class="claim-card-body">
                        <form asp-action="Dispute" method="post">
                            <input type="hidden" name="claimId" value="@Model.Id" />
                            <div class="mb-3">
                                <label for="disputeReason" class="form-label fw-semibold">Reason for Appeal</label>
                                <textarea name="reason" id="disputeReason" rows="3" class="form-control form-control-custom" 
                                          placeholder="Explain why you believe this rejection is mistaken and provide any extra verifiable information..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="me-1"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/></svg>
                                Submit Dispute to Moderation
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <!-- Right Column: Item Information & Profiles -->
        <div class="col-lg-4">
            <!-- Linked Item Card -->
            <div class="sidebar-card mb-4">
                <div class="sidebar-card-header">
                    <span class="text-uppercase small fw-bold text-muted">Linked Item</span>
                    <span class="badge @(Model.Item?.Type == FindIt.Models.ItemType.Found ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle")">
                        @(Model.Item?.Type.ToString() ?? "Item")
                    </span>
                </div>
                <div class="sidebar-card-body">
                    <div class="sidebar-item-preview">
                        @if (!string.IsNullOrEmpty(Model.Item?.ImageUrl))
                        {
                            <div class="sidebar-item-img-wrap mb-3">
                                <img src="@Model.Item.ImageUrl" alt="@Model.Item.Title" class="sidebar-item-img" />
                            </div>
                        }
                        else
                        {
                            <div class="sidebar-item-placeholder mb-3">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="4" stroke="#94A3B8" stroke-width="2"/><path d="M21 15l-5-5L5 21" stroke="#94A3B8" stroke-width="2"/></svg>
                            </div>
                        }
                        <h5 class="fw-bold mb-1">@Model.Item?.Title</h5>
                        <p class="text-muted small mb-3">Category: @(Model.Item?.Category?.Name ?? "General")</p>

                        <div class="item-meta-list mb-3">
                            <div class="item-meta-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/></svg>
                                <span>@(Model.Item?.Location ?? "Unknown Location")</span>
                            </div>
                            <div class="item-meta-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><line x1="16" y1="2" x2="16" y2="6" stroke="currentColor" stroke-width="2"/><line x1="8" y1="2" x2="8" y2="6" stroke="currentColor" stroke-width="2"/><line x1="3" y1="10" x2="21" y2="10" stroke="currentColor" stroke-width="2"/></svg>
                                <span>@(Model.Item?.DateLostOrFound.ToString("MMM dd, yyyy") ?? "N/A")</span>
                            </div>
                            <div class="item-meta-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><polyline points="12 6 12 12 16 14" stroke="currentColor" stroke-width="2"/></svg>
                                <span>Status: <strong>@(Model.Item?.Status.ToString() ?? "Open")</strong></span>
                            </div>
                        </div>

                        <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.ItemId" class="btn btn-outline-primary rounded-pill w-100 btn-sm">
                            View Full Listing & Details &rarr;
                        </a>
                    </div>
                </div>
            </div>

            <!-- Claimant Profile Card -->
            <div class="sidebar-card mb-4">
                <div class="sidebar-card-header">
                    <span class="text-uppercase small fw-bold text-muted">Claimant Information</span>
                </div>
                <div class="sidebar-card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @{
                            var claimantName = Model.Claimant?.FullName ?? "Claimant";
                            var claimantInitial = string.IsNullOrEmpty(claimantName) ? "C" : claimantName.Substring(0, 1).ToUpper();
                        }
                        <div class="user-avatar-circle">
                            @claimantInitial
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">@claimantName</h6>
                            <span class="text-muted small">@(Model.Claimant?.DepartmentOrRole ?? "Community Member")</span>
                        </div>
                    </div>

                    <div class="user-meta-info mb-3">
                        <div class="user-meta-row">
                            <span class="label">Email:</span>
                            <span class="val">@(Model.Claimant?.Email ?? "N/A")</span>
                        </div>
                        <div class="user-meta-row">
                            <span class="label">Claim Date:</span>
                            <span class="val">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>

                    @if (isFinder || isAdmin)
                    {
                        <a asp-controller="Messages" asp-action="Index" 
                           asp-route-otherUserId="@Model.ClaimantId" 
                           asp-route-itemId="@Model.ItemId" 
                           class="btn btn-primary rounded-pill w-100 d-inline-flex align-items-center justify-content-center gap-2">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2"/></svg>
                            Message Claimant
                        </a>
                    }
                </div>
            </div>

            <!-- Finder Information Card -->
            <div class="sidebar-card mb-4">
                <div class="sidebar-card-header">
                    <span class="text-uppercase small fw-bold text-muted">Finder / Reporter</span>
                </div>
                <div class="sidebar-card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @{
                            var finderName = Model.Item?.User?.FullName ?? "Finder";
                            var finderInitial = string.IsNullOrEmpty(finderName) ? "F" : finderName.Substring(0, 1).ToUpper();
                        }
                        <div class="user-avatar-circle finder">
                            @finderInitial
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">@finderName</h6>
                            <span class="text-muted small">Item Reporter</span>
                        </div>
                    </div>

                    @if (isClaimant && Model.Item?.UserId != null)
                    {
                        <a asp-controller="Messages" asp-action="Index" 
                           asp-route-otherUserId="@Model.Item.UserId" 
                           asp-route-itemId="@Model.ItemId" 
                           class="btn btn-outline-primary rounded-pill w-100 d-inline-flex align-items-center justify-content-center gap-2">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2"/></svg>
                            Message Finder
                        </a>
                    }
                </div>
            </div>

            <!-- Security & Safety Tips Card -->
            <div class="sidebar-card bg-light border-0">
                <div class="sidebar-card-body p-3">
                    <div class="d-flex gap-2">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="text-primary flex-shrink-0 mt-1"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 16v-4M12 8h.01" stroke="currentColor" stroke-width="2"/></svg>
                        <div>
                            <h6 class="fw-bold mb-1 text-dark small">Verification Tip</h6>
                            <p class="text-muted mb-0" style="font-size: 0.8rem; line-height: 1.4;">
                                Always verify identifying marks, secret characteristics, or receipts before handing over high-value valuables. Arrange in-person handover at well-lit, public campus areas.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
