@model List<FindIt.Models.Claim>
@{
    ViewData["Title"] = "My Claims";
    var incomingClaims = ViewBag.IncomingClaims as List<FindIt.Models.Claim> ?? new List<FindIt.Models.Claim>();
}

<div class="container py-4">
    <div class="dashboard-layout">
        <!-- Sidebar Navigation -->
        <aside class="sidebar-nav">
            <ul>
                <li><a asp-controller="Dashboard" asp-action="Index" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/></svg>
                    Dashboard
                </a></li>
                <li><a asp-controller="Dashboard" asp-action="MyReports" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2"/><polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="2"/></svg>
                    My Reports
                </a></li>
                <li><a asp-controller="Claims" asp-action="Index" class="sidebar-link active">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/></svg>
                    My Claims
                </a></li>
                <li><a asp-controller="Messages" asp-action="Index" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2"/></svg>
                    Messages
                </a></li>
                <li><a asp-controller="Dashboard" asp-action="Settings" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" stroke="currentColor" stroke-width="2"/></svg>
                    Settings
                </a></li>
            </ul>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="page-header mb-4">
                <h1 class="fw-bold mb-1">Claims Management</h1>
                <p class="text-secondary">Review ownership claims you've made or incoming claims on items you reported.</p>
            </div>

            <!-- Incoming Claims Requiring My Review -->
            @if (incomingClaims.Any())
            {
                <div class="mb-5">
                    <h4 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-warning text-dark">Action Required</span>
                        Incoming Claims on Your Found Items
                    </h4>
                    <div class="claims-card">
                        <table class="claims-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Claimant</th>
                                    <th>Secret Answer / Proof</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in incomingClaims)
                                {
                                    <tr>
                                        <td>
                                            <div class="item-cell">
                                                <div class="item-thumb">
                                                    @if (!string.IsNullOrEmpty(c.Item?.ImageUrl))
                                                    {
                                                        <img src="@c.Item.ImageUrl" alt="@c.Item.Title" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" />
                                                    }
                                                    else
                                                    {
                                                        <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="4" stroke="#CBD5E1" stroke-width="2"/><path d="M21 15l-5-5L5 21" stroke="#CBD5E1" stroke-width="2"/></svg>
                                                    }
                                                </div>
                                                <div>
                                                    <a asp-action="Details" asp-route-id="@c.Id" class="item-name text-decoration-none">
                                                        @c.Item?.Title
                                                    </a>
                                                    <div class="item-sub">Claim #CLM-@c.Id.ToString("D5") &bull; @c.Item?.Category?.Name</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@c.Claimant?.FullName</div>
                                            <div class="small text-muted">@c.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        </td>
                                        <td style="max-width: 250px;">
                                            <div class="small fw-bold text-dark">Answer: "@c.SecretAnswer"</div>
                                            <div class="small text-muted text-truncate">@c.ProofDescription</div>
                                            @if (!string.IsNullOrEmpty(c.ProofImageUrl))
                                            {
                                                <span class="badge bg-light text-primary border small mt-1">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="me-1"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" stroke="currentColor" stroke-width="2"/></svg>
                                                    Attachment
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="status-pill status-@c.Status.ToString().ToLower()">
                                                @c.Status
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex align-items-center gap-2">
                                                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="me-1" style="vertical-align: -2px;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
                                                    View Details
                                                </a>
                                                @if (c.Status == FindIt.Models.ClaimStatus.Pending)
                                                {
                                                    <form asp-action="Review" method="post" class="d-inline">
                                                        <input type="hidden" name="claimId" value="@c.Id" />
                                                        <input type="hidden" name="status" value="@FindIt.Models.ClaimStatus.Approved" />
                                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3" title="Approve ownership claim">Approve</button>
                                                    </form>
                                                    <form asp-action="Review" method="post" class="d-inline">
                                                        <input type="hidden" name="claimId" value="@c.Id" />
                                                        <input type="hidden" name="status" value="@FindIt.Models.ClaimStatus.Rejected" />
                                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Reject ownership claim">Reject</button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Claims Submitted By Me -->
            <div>
                <h4 class="fw-bold mb-3">Claims You Submitted</h4>
                <div class="claims-card">
                    @if (Model.Any())
                    {
                        <table class="claims-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Finder</th>
                                    <th>Your Answer / Proof</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="item-cell">
                                                <div class="item-thumb">
                                                    @if (!string.IsNullOrEmpty(c.Item?.ImageUrl))
                                                    {
                                                        <img src="@c.Item.ImageUrl" alt="@c.Item.Title" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" />
                                                    }
                                                    else
                                                    {
                                                        <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="4" stroke="#CBD5E1" stroke-width="2"/><path d="M21 15l-5-5L5 21" stroke="#CBD5E1" stroke-width="2"/></svg>
                                                    }
                                                </div>
                                                <div>
                                                    <a asp-action="Details" asp-route-id="@c.Id" class="item-name text-decoration-none">
                                                        @c.Item?.Title
                                                    </a>
                                                    <div class="item-sub">Claim #CLM-@c.Id.ToString("D5") &bull; @c.Item?.Location</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@(c.Item?.User?.FullName ?? "Finder")</div>
                                            <div class="small text-muted">@c.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        </td>
                                        <td style="max-width: 250px;">
                                            <div class="small fw-bold text-dark">"@c.SecretAnswer"</div>
                                            <div class="small text-muted text-truncate">@c.ProofDescription</div>
                                            @if (!string.IsNullOrEmpty(c.ProofImageUrl))
                                            {
                                                <span class="badge bg-light text-primary border small mt-1">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="me-1"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" stroke="currentColor" stroke-width="2"/></svg>
                                                    Attachment
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="status-pill status-@c.Status.ToString().ToLower()">
                                                @c.Status
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex align-items-center gap-2">
                                                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="me-1" style="vertical-align: -2px;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
                                                    View Details
                                                </a>
                                                <a asp-controller="Messages" asp-action="Index" 
                                                   asp-route-otherUserId="@c.Item?.UserId" 
                                                   asp-route-itemId="@c.ItemId" 
                                                   class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                                   title="Message Finder">
                                                    Message
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="p-5 text-center">
                            <p class="text-muted mb-0">You have not submitted any ownership claims yet.</p>
                        </div>
                    }
                </div>
            </div>
        </main>
    </div>
</div>
