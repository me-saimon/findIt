@model FindIt.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5" style="max-width: 480px;">
    <div class="form-card">
        <div class="text-center mb-4">
            <a asp-controller="Home" asp-action="Index" class="d-inline-flex align-items-center gap-2 text-decoration-none text-dark mb-3">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                    <path d="M11 19C15.4183 19 19 15.4183 19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19Z" stroke="#4F46E5" stroke-width="2.5" stroke-linecap="round"/>
                    <path d="M21 21L16.65 16.65" stroke="#4F46E5" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
                <span class="fs-4 fw-bold">FindIt</span>
            </a>
            <h2 class="fw-bold mb-1">Reset Password</h2>
            <p class="text-secondary small">Enter your email and we will send you password reset instructions.</p>
        </div>

        @if (ViewBag.ResetSent == true)
        {
            <div class="alert alert-success rounded-3 border-0">
                A password reset link has been dispatched to your email address (Simulated in development mode).
            </div>
            <a asp-action="Login" class="btn-primary-custom w-100 text-center">Back to Login</a>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <div class="form-group mb-4">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control-custom" placeholder="name@campus.edu" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-primary-custom w-100 py-2 mb-3">
                    Send Reset Link
                </button>

                <div class="text-center small text-secondary">
                    Remember your credentials? 
                    <a asp-action="Login" class="fw-semibold text-primary text-decoration-none">Sign In</a>
                </div>
            </form>
        }
    </div>
</div>
