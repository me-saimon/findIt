@model FindIt.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5" style="max-width: 500px;">
    <div class="form-card">
        <div class="text-center mb-4">
            <a asp-controller="Home" asp-action="Index" class="d-inline-flex align-items-center gap-2 text-decoration-none text-dark mb-3">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                    <path d="M11 19C15.4183 19 19 15.4183 19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19Z" stroke="#4F46E5" stroke-width="2.5" stroke-linecap="round"/>
                    <path d="M21 21L16.65 16.65" stroke="#4F46E5" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
                <span class="fs-4 fw-bold">FindIt</span>
            </a>
            <h2 class="fw-bold mb-1">Welcome Back</h2>
            <p class="text-secondary small">Sign in to report, track, and recover your lost belongings.</p>
        </div>

        <!-- Quick Demo Credentials Callout -->
        <div class="p-3 bg-light rounded-3 border mb-4 small">
            <span class="fw-bold text-primary d-block mb-1">Demo Accounts (Pre-Seeded):</span>
            <div class="d-flex justify-content-between mb-1">
                <span><strong>Admin:</strong> admin@findit.com</span>
                <code>Admin@123</code>
            </div>
            <div class="d-flex justify-content-between">
                <span><strong>User:</strong> john@findit.com</span>
                <code>User@123</code>
            </div>
        </div>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control-custom" placeholder="name@campus.edu" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Password" class="form-label mb-0">Password</label>
                    <a asp-action="ForgotPassword" class="small text-decoration-none">Forgot?</a>
                </div>
                <input asp-for="Password" class="form-control-custom" placeholder="Enter your password" required />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small text-secondary">
                    Remember me on this device
                </label>
            </div>

            <button type="submit" class="btn-primary-custom w-100 py-2 mb-3">
                Sign In
            </button>

            <div class="text-center small text-secondary">
                Don't have an account? 
                <a asp-action="Register" class="fw-semibold text-primary text-decoration-none">Create Account</a>
            </div>
        </form>
    </div>
</div>
