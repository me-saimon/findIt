@model FindIt.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "User Dashboard";
}

<div class="container py-4">
    <div class="dashboard-layout">
        <!-- Sidebar Navigation -->
        <aside class="sidebar-nav">
            <ul>
                <li><a asp-controller="Dashboard" asp-action="Index" class="sidebar-link active">
                    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/></svg>
                    Dashboard
                </a></li>
                <li><a asp-controller="Dashboard" asp-action="MyReports" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2"/><polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="2"/></svg>
                    My Reports
                </a></li>
                <li><a asp-controller="Claims" asp-action="Index" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/></svg>
                    My Claims
                </a></li>
                <li><a asp-controller="Messages" asp-action="Index" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2"/></svg>
                    Messages
                </a></li>
                <li><a asp-controller="Dashboard" asp-action="Settings" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" stroke="currentColor" stroke-width="2"/></svg>
                    Settings
                </a></li>
            </ul>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Welcome Card -->
            <div class="bg-white border rounded-4 p-4 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h2 class="fw-bold mb-1">Welcome back, @Model.User.FullName!</h2>
                    <p class="text-secondary mb-0">Here is a summary of your lost & found activities on campus.</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Items" asp-action="Create" asp-route-type="0" class="btn-danger-custom">Report Lost</a>
                    <a asp-controller="Items" asp-action="Create" asp-route-type="1" class="btn-success-custom">Report Found</a>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-icon icon-blue">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2"/><polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="2"/></svg>
                        </div>
                        <div class="stat-info">
                            <h3>@Model.MyReportCount</h3>
                            <p>Items You Reported</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-icon icon-orange">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/></svg>
                        </div>
                        <div class="stat-info">
                            <h3>@Model.MyClaimCount</h3>
                            <p>Claims Submitted</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-icon icon-green">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke="currentColor" stroke-width="2"/><polyline points="22 4 12 14.01 9 11.01" stroke="currentColor" stroke-width="2"/></svg>
                        </div>
                        <div class="stat-info">
                            <h3>@Model.ResolvedCount</h3>
                            <p>Items Reunited</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Reports Table -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0">Your Recent Reports</h4>
                    <a asp-action="MyReports" class="text-decoration-none fw-semibold small">View All &rarr;</a>
                </div>

                <div class="reports-card">
                    @if (Model.MyRecentReports.Any())
                    {
                        <table class="reports-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Type</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.MyRecentReports)
                                {
                                    <tr>
                                        <td>
                                            <div class="item-cell">
                                                <div class="item-thumb">
                                                    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="4" stroke="#CBD5E1" stroke-width="2"/><path d="M21 15l-5-5L5 21" stroke="#CBD5E1" stroke-width="2"/></svg>
                                                </div>
                                                <div>
                                                    <div class="item-name">@r.Title</div>
                                                    <div class="item-sub">@r.Location</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @(r.Type == FindIt.Models.ItemType.Lost ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success")">
                                                @r.Type
                                            </span>
                                        </td>
                                        <td>@r.DateLostOrFound.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="status-pill status-@r.Status.ToString().ToLower()">
                                                @r.Status
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Items" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            You have not reported any items yet.
                        </div>
                    }
                </div>
            </div>
        </main>
    </div>
</div>
