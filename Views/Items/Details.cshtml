@model FindIt.Models.Item
@{
    ViewData["Title"] = Model.Title;
    var matches = ViewBag.Matches as List<FindIt.Services.MatchResult> ?? new List<FindIt.Services.MatchResult>();
    bool isOwner = ViewBag.IsOwner ?? false;
    bool hasClaimed = ViewBag.HasClaimed ?? false;
}

<div class="container py-4">
    <!-- Breadcrumbs -->
    <nav class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Items" asp-action="Browse">Browse</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Main Item Details -->
        <div class="col-lg-8">
            <div class="bg-white border rounded-4 p-4 p-md-5 mb-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <span class="item-cat fs-6">@Model.Category?.Name</span>
                        <h1 class="fw-bold mb-2">@Model.Title</h1>
                    </div>
                    <span class="status-badge-lg @(Model.Type == FindIt.Models.ItemType.Lost ? "badge-lost" : "badge-found")">
                        @(Model.Type == FindIt.Models.ItemType.Lost ? "LOST ITEM" : "FOUND ITEM")
                    </span>
                </div>

                <!-- Photo or Placeholder -->
                <div class="item-image-large mb-4 rounded-4 overflow-hidden border">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Title" class="w-100 h-100 object-fit-cover" />
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="3" y="3" width="18" height="18" rx="4" stroke="#CBD5E1" stroke-width="2"/>
                            <circle cx="8.5" cy="8.5" r="1.5" fill="#CBD5E1"/>
                            <path d="M21 15l-5-5L5 21" stroke="#CBD5E1" stroke-width="2"/>
                        </svg>
                    }
                </div>

                <!-- Description -->
                <div class="mb-4">
                    <h5 class="fw-bold mb-2">Description</h5>
                    <p class="text-secondary leading-relaxed mb-0">@Model.Description</p>
                </div>

                <!-- Metadata Grid -->
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Location</span>
                            <div class="fw-semibold d-flex align-items-center gap-2">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 21C16 17 20 13 20 9A8 8 0 1 0 4 9C4 13 8 17 12 21Z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="2"/></svg>
                                @Model.Location
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Date Reported</span>
                            <div class="fw-semibold d-flex align-items-center gap-2">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2"/></svg>
                                @Model.DateLostOrFound.ToString("MMMM dd, yyyy")
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Status</span>
                            <span class="status-pill @(Model.Status == FindIt.Models.ItemStatus.Open ? "status-pending" : "status-approved")">
                                @Model.Status
                            </span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Category</span>
                            <span class="fw-semibold">@Model.Category?.Name</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.SecretIdentifier))
                {
                    <div class="security-callout mt-4">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/></svg>
                        <div>
                            <strong>Verification Required:</strong> The finder requires true owners to answer:
                            <div class="fst-italic text-dark mt-1">"@Model.SecretIdentifier"</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Actions & Smart Matches -->
        <div class="col-lg-4">
            <!-- Reporter Info & Action Card -->
            <div class="bg-white border rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3">Reported By</h5>
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="user-avatar" style="width: 48px; height: 48px; font-size: 1.1rem;">
                        @(Model.User?.FullName?.Length > 0 ? Model.User.FullName[0].ToString().ToUpper() : "U")
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">@(Model.User?.FullName ?? "Campus Member")</h6>
                        <span class="text-muted small">@(Model.User?.DepartmentOrRole ?? "Student")</span>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    @if (Model.Type == FindIt.Models.ItemType.Found && Model.Status == FindIt.Models.ItemStatus.Open && !isOwner)
                    {
                        @if (hasClaimed)
                        {
                            <button class="btn btn-secondary py-2" disabled>Claim Already Submitted</button>
                        }
                        else
                        {
                            <a asp-controller="Claims" asp-action="Submit" asp-route-itemId="@Model.Id" class="btn-success-custom py-2">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/></svg>
                                Claim This Item
                            </a>
                        }
                    }

                    @if (!isOwner)
                    {
                        <a asp-controller="Messages" asp-action="Index" 
                           asp-route-otherUserId="@Model.UserId" 
                           asp-route-itemId="@Model.Id" 
                           class="btn-primary-custom py-2">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2"/></svg>
                            Send Message to Finder/Owner
                        </a>
                    }
                    else
                    {
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this report?');">
                            <button type="submit" class="btn-danger-custom w-100 py-2">Delete Report</button>
                        </form>
                    }
                </div>
            </div>

            <!-- Smart Matching Suggestions -->
            <div class="smart-match-box border rounded-4 p-4">
                <div class="match-icon bg-white text-primary mb-3">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <h5 class="fw-bold mb-1">Smart Match Engine</h5>
                <p class="text-secondary small mb-3">
                    Automated recommendations comparing categories, locations, and dates.
                </p>

                @if (matches.Any())
                {
                    <div class="d-flex flex-column gap-3 text-start">
                        @foreach (var m in matches)
                        {
                            <div class="p-3 bg-white border rounded-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-success-subtle text-success fw-bold">@m.Score% Match</span>
                                    <span class="small text-muted">@m.CandidateItem.DateLostOrFound.ToString("MMM dd")</span>
                                </div>
                                <h6 class="fw-bold mb-1 text-truncate">@m.CandidateItem.Title</h6>
                                <p class="small text-muted mb-2">@m.Reason</p>
                                <a asp-action="Details" asp-route-id="@m.CandidateItem.Id" class="btn btn-sm btn-outline-primary w-100">
                                    View Potential Match &rarr;
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="small text-muted mb-0">No potential matches identified yet. The system checks constantly as new items are posted.</p>
                }
            </div>
        </div>
    </div>
</div>
