@model FindIt.Models.Item
@{
    ViewData["Title"] = Model.Title;
    var matches = ViewBag.Matches as List<FindIt.Services.MatchResult> ?? new List<FindIt.Services.MatchResult>();
    bool isOwner = ViewBag.IsOwner ?? false;
    bool hasClaimed = ViewBag.HasClaimed ?? false;
    bool isLost = Model.Type == FindIt.Models.ItemType.Lost;

    // Helper for avatar gradient
    string GetAvatarGradient(string? name)
    {
        string[] gradients = [
            "linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%)",
            "linear-gradient(135deg, #0284C7 0%, #2563EB 100%)",
            "linear-gradient(135deg, #059669 0%, #10B981 100%)",
            "linear-gradient(135deg, #D97706 0%, #F59E0B 100%)",
            "linear-gradient(135deg, #E11D48 0%, #F43F5E 100%)"
        ];
        int hash = Math.Abs((name ?? "U").GetHashCode());
        return gradients[hash % gradients.Length];
    }

    var avatarBg = GetAvatarGradient(Model.User?.FullName);
    var userInitial = !string.IsNullOrWhiteSpace(Model.User?.FullName) ? Model.User.FullName[0].ToString().ToUpper() : "U";
}

<div class="container py-4">
    <!-- Breadcrumbs Navigation -->
    <nav class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="2"/><polyline points="9 22 9 12 15 12 15 22" stroke="currentColor" stroke-width="2"/></svg>
                    Home
                </a>
            </li>
            <li class="breadcrumb-item"><a asp-controller="Items" asp-action="Browse">Browse Items</a></li>
            @if (Model.Category != null)
            {
                <li class="breadcrumb-item"><a asp-controller="Items" asp-action="Browse" asp-route-categoryId="@Model.CategoryId">@Model.Category.Name</a></li>
            }
            <li class="breadcrumb-item active text-truncate" style="max-width: 280px;" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- ================= Main Item Showcase (Left) ================= -->
        <div class="col-lg-8">
            <div class="item-details-card mb-4">
                
                <!-- Category Pill & Large Status Badge Row -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="category-pill">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" stroke="currentColor" stroke-width="2"/><circle cx="7" cy="7" r="1.5" fill="currentColor"/></svg>
                            @(Model.Category?.Name ?? "General")
                        </span>
                        <span class="text-muted small fw-semibold">#ITM-@Model.Id.ToString("D4")</span>
                    </div>

                    <span class="status-badge-lg @(isLost ? "badge-lost" : "badge-found")">
                        @if (isLost)
                        {
                            <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2"/></svg>
                            <span>LOST ITEM</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/></svg>
                            <span>FOUND ITEM</span>
                        }
                    </span>
                </div>

                <!-- Item Title -->
                <h1 class="fw-bold mb-3 text-dark" style="letter-spacing: -0.02em;">@Model.Title</h1>

                <!-- Photo or Placeholder Stage -->
                <div class="item-image-stage mb-4">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Title" />
                        <span class="photo-verified-tag">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="13" r="4" stroke="currentColor" stroke-width="2"/></svg>
                            Photo Attached
                        </span>
                    }
                    else
                    {
                        <div class="item-image-placeholder">
                            <div class="placeholder-icon-wrap">
                                <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="4" stroke="currentColor" stroke-width="2"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="2"/></svg>
                            </div>
                            <h6 class="placeholder-title">No Photo Uploaded</h6>
                            <p class="placeholder-subtitle mb-0">The reporter did not provide an image. Please verify through the detailed description and questions below.</p>
                        </div>
                    }
                </div>

                <!-- Description Section -->
                <div class="mb-4">
                    <h5 class="fw-bold mb-2 text-dark d-flex align-items-center gap-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="#4F46E5" stroke-width="2"/><polyline points="14 2 14 8 20 8" stroke="#4F46E5" stroke-width="2"/><line x1="16" y1="13" x2="8" y2="13" stroke="#4F46E5" stroke-width="2"/><line x1="16" y1="17" x2="8" y2="17" stroke="#4F46E5" stroke-width="2"/><polyline points="10 9 9 9 8 9" stroke="#4F46E5" stroke-width="2"/></svg>
                        Detailed Description
                    </h5>
                    <p class="text-secondary leading-relaxed mb-0 fs-6" style="white-space: pre-line;">@Model.Description</p>
                </div>

                <!-- Metadata Grid -->
                <div class="row g-3 mb-4">
                    <!-- Location Card -->
                    <div class="col-sm-6">
                        <div class="meta-grid-card">
                            <div class="meta-card-icon icon-blue-tint">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M12 21C16 17 20 13 20 9A8 8 0 1 0 4 9C4 13 8 17 12 21Z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="2"/></svg>
                            </div>
                            <div class="meta-card-content">
                                <span class="meta-card-label">Location</span>
                                <div class="meta-card-value" title="@Model.Location">@Model.Location</div>
                            </div>
                        </div>
                    </div>

                    <!-- Date Lost / Found Card -->
                    <div class="col-sm-6">
                        <div class="meta-grid-card">
                            <div class="meta-card-icon icon-amber-tint">
                                <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2"/></svg>
                            </div>
                            <div class="meta-card-content">
                                <span class="meta-card-label">@(isLost ? "Date Lost" : "Date Found")</span>
                                <div class="meta-card-value">@Model.DateLostOrFound.ToString("MMMM dd, yyyy")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Category Card -->
                    <div class="col-sm-6">
                        <div class="meta-grid-card">
                            <div class="meta-card-icon icon-purple-tint">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke="currentColor" stroke-width="2"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" stroke="currentColor" stroke-width="2"/></svg>
                            </div>
                            <div class="meta-card-content">
                                <span class="meta-card-label">Category</span>
                                <div class="meta-card-value">@(Model.Category?.Name ?? "Uncategorized")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Status Card -->
                    <div class="col-sm-6">
                        <div class="meta-grid-card">
                            <div class="meta-card-icon icon-emerald-tint">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke="currentColor" stroke-width="2"/><polyline points="22 4 12 14.01 9 11.01" stroke="currentColor" stroke-width="2"/></svg>
                            </div>
                            <div class="meta-card-content">
                                <span class="meta-card-label">Current Status</span>
                                <div class="meta-card-value">
                                    <span class="status-pill @(Model.Status == FindIt.Models.ItemStatus.Open ? "status-found" : Model.Status == FindIt.Models.ItemStatus.Claimed ? "status-pending" : "status-approved")">
                                        @Model.Status
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Verification Question Callout (For Found items with Secret Identifier) -->
                @if (!string.IsNullOrEmpty(Model.SecretIdentifier))
                {
                    <div class="security-callout-box">
                        <div class="security-icon-badge">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/><polyline points="9 12 11 14 15 10" stroke="currentColor" stroke-width="2"/></svg>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="security-content-title">Ownership Verification Question</h6>
                            <p class="security-content-desc">To prevent fraudulent claims, the finder asks the claimant to answer the following question when submitting a claim:</p>
                            <div class="security-question-quote">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#059669" stroke-width="2"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" stroke="#059669" stroke-width="2"/><line x1="12" y1="17" x2="12.01" y2="17" stroke="#059669" stroke-width="2"/></svg>
                                <span>"@Model.SecretIdentifier"</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- ================= Sidebar Actions & Smart Engine (Right) ================= -->
        <div class="col-lg-4">
            <!-- Reporter Profile & Action Card -->
            <div class="details-sidebar-card mb-4">
                <h5 class="fw-bold mb-3 text-dark">Reported By</h5>
                
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="reporter-avatar-large" style="background: @avatarBg;">
                        @userInitial
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1 text-dark">@(Model.User?.FullName ?? "Campus Member")</h6>
                        <span class="badge bg-light text-secondary border fw-medium px-2 py-1">
                            @(Model.User?.DepartmentOrRole ?? "Student")
                        </span>
                    </div>
                </div>

                <!-- Primary Action Buttons -->
                <div class="d-grid gap-2 mb-3">
                    @if (Model.Type == FindIt.Models.ItemType.Found && Model.Status == FindIt.Models.ItemStatus.Open && !isOwner)
                    {
                        @if (hasClaimed)
                        {
                            <button class="btn btn-secondary py-2 fw-semibold d-flex align-items-center justify-content-center gap-2" disabled>
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke="currentColor" stroke-width="2"/><polyline points="22 4 12 14.01 9 11.01" stroke="currentColor" stroke-width="2"/></svg>
                                Claim Already Submitted
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Claims" asp-action="Submit" asp-route-itemId="@Model.Id" class="btn-success-custom py-2 justify-content-center">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/><polyline points="9 12 11 14 15 10" stroke="currentColor" stroke-width="2"/></svg>
                                Claim This Item
                            </a>
                        }
                    }

                    @if (!isOwner)
                    {
                        <a asp-controller="Messages" asp-action="Index" 
                           asp-route-otherUserId="@Model.UserId" 
                           asp-route-itemId="@Model.Id" 
                           class="btn-primary-custom py-2 justify-content-center">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2"/></svg>
                            Message @(isLost ? "Owner" : "Finder")
                        </a>
                    }
                    else
                    {
                        <div class="p-3 bg-light rounded-3 border mb-2 text-center">
                            <span class="small text-muted d-block mb-1">You reported this item</span>
                            <span class="badge bg-primary-subtle text-primary">Owner Mode</span>
                        </div>
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this report? This cannot be undone.');">
                            <button type="submit" class="btn-danger-custom w-100 py-2 justify-content-center">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><polyline points="3 6 5 6 21 6" stroke="currentColor" stroke-width="2"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="2"/></svg>
                                Delete Report
                            </button>
                        </form>
                    }

                    <!-- Share Button with Toast Copy -->
                    <button type="button" class="btn-outline-custom py-2 justify-content-center mt-1" id="shareBtn" onclick="copyCurrentUrl()">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="2"/><circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="2"/><circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="2"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" stroke="currentColor" stroke-width="2"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" stroke="currentColor" stroke-width="2"/></svg>
                        <span id="shareBtnText">Share Item Link</span>
                    </button>
                </div>
            </div>

            <!-- Smart Matching Suggestions Engine -->
            <div class="smart-match-box mb-4">
                <div class="match-header-row">
                    <div class="match-icon-badge">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">Smart Match Engine</h6>
                        <span class="small text-muted d-flex align-items-center gap-1">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="text-primary"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
                            Powered by Google Gemini
                        </span>
                    </div>
                </div>

                <p class="text-secondary small mb-3">
                    Deep semantic correlation analyzing item brands, descriptions, campus locations, and timelines.
                </p>

                @if (matches.Any())
                {
                    <div class="d-flex flex-column gap-3 text-start">
                        @foreach (var m in matches)
                        {
                            <div class="match-item-card">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="match-score-pill">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                            @m.Score% Match
                                        </span>
                                        @if (m.IsAiPowered)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border" style="font-size: 0.65rem; padding: 0.2rem 0.4rem;" title="AI Verified Match">
                                                ✦ Gemini AI
                                            </span>
                                        }
                                    </div>
                                    <span class="small text-muted">@m.CandidateItem.DateLostOrFound.ToString("MMM dd")</span>
                                </div>
                                <h6 class="fw-bold mb-1 text-truncate text-dark" title="@m.CandidateItem.Title">@m.CandidateItem.Title</h6>
                                <p class="small text-muted mb-2 lh-sm">@m.Reason</p>
                                <a asp-action="Details" asp-route-id="@m.CandidateItem.Id" class="btn btn-sm btn-outline-primary rounded-pill w-100 fw-semibold">
                                    View Potential Match &rarr;
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-3 bg-white rounded-3 border text-center">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-muted mb-2"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><line x1="12" y1="8" x2="12" y2="12" stroke="currentColor" stroke-width="2"/><line x1="12" y1="16" x2="12.01" y2="16" stroke="currentColor" stroke-width="2"/></svg>
                        <p class="small text-muted mb-0">No potential matches identified yet. System continually scans as new reports arrive.</p>
                    </div>
                }
            </div>

            <!-- Campus Safety & Claiming Tips -->
            <div class="safety-tips-card">
                <h6 class="fw-bold mb-2 text-dark d-flex align-items-center gap-2">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="#059669" stroke-width="2"/></svg>
                    Campus Safety Tips
                </h6>
                <ul class="list-unstyled small text-secondary mb-0 d-flex flex-column gap-2">
                    <li class="d-flex align-items-start gap-2">
                        <span class="text-success fw-bold">✓</span>
                        <span>Provide exact identifying details (serial no., stickers, screen wallpaper).</span>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <span class="text-success fw-bold">✓</span>
                        <span>Use FindIt messages to keep an audit trail of communications.</span>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <span class="text-success fw-bold">✓</span>
                        <span>Meet in public campus areas (Library Help Desk or Security Reception).</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyCurrentUrl() {
            navigator.clipboard.writeText(window.location.href).then(function() {
                const btnText = document.getElementById('shareBtnText');
                if (btnText) {
                    const original = btnText.innerText;
                    btnText.innerText = 'Copied to Clipboard!';
                    setTimeout(function() {
                        btnText.innerText = original;
                    }, 2000);
                }
            });
        }
    </script>
}
