@model FindIt.Models.ViewModels.BrowseViewModel
@{
    ViewData["Title"] = "Browse Items";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Browse Lost & Found Items</h1>
            <p class="text-secondary mb-0">Search and filter through all reported items across campus.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" asp-route-type="0" class="btn-danger-custom">Report Lost</a>
            <a asp-action="Create" asp-route-type="1" class="btn-success-custom">Report Found</a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Filters -->
        <div class="col-lg-3">
            <div class="bg-white border rounded-4 p-4 sticky-top" style="top: 85px;">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M6 12h12M8 18h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    Filters
                </h5>

                <form method="get" asp-action="Browse" id="filterForm">
                    <!-- Search Input -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Keywords</label>
                        <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm rounded-3" placeholder="Search title or location..." />
                    </div>

                    <!-- Item Type -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Type</label>
                        <select name="type" class="form-select form-select-sm rounded-3" onchange="this.form.submit()">
                            <option value="">All Types (Lost & Found)</option>
                            <option value="0" selected="@(Model.Type == FindIt.Models.ItemType.Lost)">Lost Only</option>
                            <option value="1" selected="@(Model.Type == FindIt.Models.ItemType.Found)">Found Only</option>
                        </select>
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Category</label>
                        <select name="categoryId" class="form-select form-select-sm rounded-3" onchange="this.form.submit()">
                            <option value="">All Categories</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Status -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Status</label>
                        <select name="status" class="form-select form-select-sm rounded-3" onchange="this.form.submit()">
                            <option value="">All Statuses</option>
                            <option value="0" selected="@(Model.Status == FindIt.Models.ItemStatus.Open)">Open</option>
                            <option value="1" selected="@(Model.Status == FindIt.Models.ItemStatus.Claimed)">Claimed</option>
                            <option value="2" selected="@(Model.Status == FindIt.Models.ItemStatus.Resolved)">Resolved</option>
                        </select>
                    </div>

                    <!-- Sort -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">Sort By</label>
                        <select name="sortBy" class="form-select form-select-sm rounded-3" onchange="this.form.submit()">
                            <option value="newest" selected="@(Model.SortBy == "newest")">Newest First</option>
                            <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest First</option>
                            <option value="title" selected="@(Model.SortBy == "title")">Title (A-Z)</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn-primary-custom py-2">Apply Filters</button>
                        <a asp-action="Browse" class="btn-outline-custom py-2 text-center">Reset</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Items Grid -->
        <div class="col-lg-9">
            <!-- Toolbar -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted small">
                    Showing <strong>@Model.Items.Count</strong> of <strong>@Model.TotalItems</strong> items
                </span>
            </div>

            @if (Model.Items.Any())
            {
                <div class="row g-4">
                    @foreach (var item in Model.Items)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="item-card">
                                <div class="item-img-wrapper">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Title" />
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <rect x="3" y="3" width="18" height="18" rx="4" stroke="#CBD5E1" stroke-width="2"/>
                                            <circle cx="8.5" cy="8.5" r="1.5" fill="#CBD5E1"/>
                                            <path d="M21 15l-5-5L5 21" stroke="#CBD5E1" stroke-width="2"/>
                                        </svg>
                                    }
                                    <span class="status-badge @(item.Type == FindIt.Models.ItemType.Lost ? "badge-lost" : "badge-found")">
                                        @(item.Type == FindIt.Models.ItemType.Lost ? "LOST" : "FOUND")
                                    </span>
                                </div>
                                <div class="item-body">
                                    <span class="item-cat">@item.Category?.Name</span>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="item-title">
                                        @item.Title
                                    </a>
                                    <div class="item-meta">
                                        <div class="meta-row">
                                            <svg viewBox="0 0 24 24" fill="none"><path d="M12 21C16 17 20 13 20 9A8 8 0 1 0 4 9C4 13 8 17 12 21Z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="2"/></svg>
                                            <span class="text-truncate">@item.Location</span>
                                        </div>
                                        <div class="meta-row">
                                            <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2"/></svg>
                                            <span>@item.DateLostOrFound.ToString("MMM dd, yyyy")</span>
                                        </div>
                                    </div>
                                    <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                        <span class="status-pill @(item.Status == FindIt.Models.ItemStatus.Open ? "status-pending" : "status-approved")">
                                            @item.Status
                                        </span>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            View &rarr;
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-center mt-5">
                        <nav>
                            <ul class="pagination">
                                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                                    <a class="page-link" asp-action="Browse" 
                                       asp-route-page="@(Model.Page - 1)" 
                                       asp-route-search="@Model.Search" 
                                       asp-route-categoryId="@Model.CategoryId" 
                                       asp-route-type="@Model.Type" 
                                       asp-route-status="@Model.Status" 
                                       asp-route-sortBy="@Model.SortBy">&laquo; Prev</a>
                                </li>
                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    <li class="page-item @(Model.Page == p ? "active" : "")">
                                        <a class="page-link" asp-action="Browse" 
                                           asp-route-page="@p" 
                                           asp-route-search="@Model.Search" 
                                           asp-route-categoryId="@Model.CategoryId" 
                                           asp-route-type="@Model.Type" 
                                           asp-route-status="@Model.Status" 
                                           asp-route-sortBy="@Model.SortBy">@p</a>
                                    </li>
                                }
                                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" asp-action="Browse" 
                                       asp-route-page="@(Model.Page + 1)" 
                                       asp-route-search="@Model.Search" 
                                       asp-route-categoryId="@Model.CategoryId" 
                                       asp-route-type="@Model.Type" 
                                       asp-route-status="@Model.Status" 
                                       asp-route-sortBy="@Model.SortBy">Next &raquo;</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="bg-white border rounded-4 p-5 text-center">
                    <h5 class="fw-bold mb-2">No Items Found</h5>
                    <p class="text-muted mb-4">No reports matched your current search filters.</p>
                    <a asp-action="Browse" class="btn-primary-custom">Clear All Filters</a>
                </div>
            }
        </div>
    </div>
</div>
